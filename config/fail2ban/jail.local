# 5 fallos en 10 minutos = bloqueo de 10 minutos
[DEFAULT]
bantime  = 10m
findtime = 10m
maxretry = 5
banaction = ufw

[sshd]
enabled = true
backend = systemd
# En Ubuntu 24.04 la unidad es ssh.service (fail2ban busca sshd.service por defecto)
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd

# Logins fallidos de la app (log propio); se bloquean 80 y 443
[chatia-login]
enabled  = true
port     = http,https
filter   = chatia-login
logpath  = /var/log/chatia/app.log
maxretry = 10
